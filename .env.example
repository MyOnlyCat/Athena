ATHENA_HTTP_PORT=8080
ATHENA_JWT_SECRET=replace-with-at-least-32-random-characters
ATHENA_CREDENTIAL_KEY=replace-with-a-valid-44-character-fernet-key
ATHENA_BOOTSTRAP_USERNAME=admin
ATHENA_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ATHENA_NODE_ID=athena-node-local
ATHENA_NODE_NAME=Athena Node
ATHENA_MASTER_NODE_URL=https://athena-master.example.com
ATHENA_NODE_TOKEN=replace-with-node-token
ATHENA_ALLOW_HTTP_ARTIFACTS=false
ATHENA_HOST_PROBE_INTERVAL_MINUTES=5

# Athena-Master uses an independent configuration namespace.
ATHENA_MASTER_ENVIRONMENT=development
ATHENA_MASTER_DATABASE_URL=sqlite+aiosqlite:///./data/athena-master.db
ATHENA_MASTER_JWT_SECRET=replace-with-at-least-32-random-characters
ATHENA_MASTER_CREDENTIAL_KEY=replace-with-a-valid-44-character-fernet-key
ATHENA_MASTER_BOOTSTRAP_USERNAME=admin
ATHENA_MASTER_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ATHENA_MASTER_DATA_DIR=./data
