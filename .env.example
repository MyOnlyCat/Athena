ATHENA_HTTP_PORT=8080
ATHENA_JWT_SECRET=replace-with-at-least-32-random-characters
ATHENA_CREDENTIAL_KEY=replace-with-a-valid-44-character-fernet-key
ATHENA_BOOTSTRAP_USERNAME=admin
ATHENA_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ATHENA_NODE_ID=athena-node-local
ATHENA_NODE_NAME=Athena Node
ATHENA_MASTER_NODE_URL=https://athena-master.example.com
ATHENA_NODE_TOKEN=replace-with-node-token
ATHENA_ALLOW_HTTP_ARTIFACTS=false
ATHENA_HOST_PROBE_INTERVAL_MINUTES=5

# Athena-Master uses an independent configuration namespace.
ATHENA_MASTER_ENVIRONMENT=development
ATHENA_MASTER_DATABASE_URL=postgresql+asyncpg://athena_master:replace-with-a-strong-database-password@postgres:5432/athena_master
ATHENA_MASTER_DATABASE_SCHEMA=public
ATHENA_MASTER_DATABASE_POOL_SIZE=10
ATHENA_MASTER_DATABASE_MAX_OVERFLOW=20
ATHENA_MASTER_DATABASE_POOL_TIMEOUT_SECONDS=30
ATHENA_MASTER_DATABASE_STATEMENT_TIMEOUT_MS=30000
ATHENA_MASTER_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
ATHENA_MASTER_DATABASE_LOCK_TIMEOUT_MS=10000
ATHENA_MASTER_POSTGRES_DB=athena_master
ATHENA_MASTER_POSTGRES_USER=athena_master
ATHENA_MASTER_POSTGRES_PASSWORD=replace-with-a-strong-database-password
ATHENA_MASTER_API_PORT=8001
ATHENA_MASTER_JWT_SECRET=replace-with-at-least-32-random-characters
ATHENA_MASTER_CREDENTIAL_KEY=replace-with-a-valid-44-character-fernet-key
ATHENA_MASTER_BOOTSTRAP_USERNAME=admin
ATHENA_MASTER_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ATHENA_MASTER_DATA_DIR=./data

# Production rejects the public replace-with-* values above. Replace every
# placeholder before starting master-api.

# Host-side integration tests use the disposable PostgreSQL service in
# Athena-Master/deploy/compose.test.yaml.
ATHENA_TEST_POSTGRES_PORT=55432
ATHENA_TEST_POSTGRES_URL=postgresql+asyncpg://athena_test:athena_test@127.0.0.1:55432/athena_test
